<Window x:Class="VideoCutter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoCutter · cortar y unir vídeos" Width="1180" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="4,3"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="6,3"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6,4"/></Style>
    <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,18,0,6"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#666666"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock FontSize="24" FontWeight="Bold" Text="✂ VideoCutter"/>
      <TextBlock Style="{StaticResource Muted}" Text="Corta y une vídeos en tu ordenador, sin límites de tamaño."/>

      <!-- Aviso si falta FFmpeg -->
      <Border x:Name="FfmpegBanner" Visibility="Collapsed" Background="#FFF4D6" BorderBrush="#E0B84A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock x:Name="FfmpegText" TextWrapping="Wrap" Text="Falta FFmpeg, el motor que corta y une los vídeos. Se descarga una sola vez (unos 200 MB)."/>
          <ProgressBar x:Name="FfmpegProgress" Height="8" Margin="0,8,0,0" Visibility="Collapsed" Maximum="100"/>
          <Button x:Name="BtnDownloadFfmpeg" HorizontalAlignment="Left" Content="Descargar FFmpeg ahora" Click="BtnDownloadFfmpeg_Click"/>
        </StackPanel>
      </Border>

      <!-- Paso 1 -->
      <TextBlock Style="{StaticResource H2}" Text="1. Añadir vídeos"/>
      <Border x:Name="DropZone" AllowDrop="True" Background="#F3F6FF" BorderBrush="#7A8FD0" BorderThickness="2" CornerRadius="12" Padding="28" Cursor="Hand"
              Drop="DropZone_Drop" DragOver="DropZone_DragOver" MouseLeftButtonUp="DropZone_Click">
        <TextBlock TextAlignment="Center" FontSize="15" Foreground="#4A5A94"
                   Text="Suelta aquí todos tus vídeos (o haz clic para elegirlos)&#10;Los MP4 van directos a la lista; los demás se convierten a MP4 de uno en uno."/>
      </Border>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F7F7F9" CornerRadius="10" Padding="12" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="Cola de conversión" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <ListBox x:Name="QueueList" Height="150" Margin="0,8,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#666666" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#F7F7F9" CornerRadius="10" Padding="12" Margin="6,0,0,0">
          <StackPanel>
            <DockPanel>
              <Button x:Name="BtnToEditor" DockPanel.Dock="Right" Content="Pasar Videos al Editor" IsEnabled="False" Click="BtnToEditor_Click"/>
              <TextBlock Text="Videos MP4" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox x:Name="Mp4List" Height="150" Margin="0,8,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Margin="8,0,0,0" Tag="{Binding}" Click="RemoveMp4_Click"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock x:Name="CStat" Style="{StaticResource Muted}" Margin="0,6,0,0"/>

      <!-- Paso 2 -->
      <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
        <TextBlock Style="{StaticResource H2}" Text="2. Editor"/>
        <TextBlock Style="{StaticResource Muted}" Text="Arrastra las diapositivas para ordenarlas: ese es el orden del vídeo final. Haz clic en una para previsualizarla y ajustar su recorte."/>
        <ListBox x:Name="SlideList" Margin="0,8,0,0" SelectionMode="Single" SelectionChanged="SlideList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="AllowDrop" Value="True"/>
              <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Slide_PreviewMouseDown"/>
              <EventSetter Event="PreviewMouseMove" Handler="Slide_PreviewMouseMove"/>
              <EventSetter Event="Drop" Handler="Slide_Drop"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="176" Margin="4">
                <Grid Height="99" Background="Black">
                  <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                  <Border Background="#CC000000" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
                    <TextBlock Foreground="White" FontSize="12" Text="{Binding Number}"/>
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Range}" FontSize="11" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                <CheckBox IsChecked="{Binding Mark, Mode=TwoWay}" Content="marcado" FontSize="11" Margin="0,2,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="DetailPanel" Visibility="Collapsed" Background="#F7F7F9" CornerRadius="10" Padding="14" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
              <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                            Height="300" Volume="0.8" MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"/>
              <DockPanel Margin="0,6,0,0">
                <Button x:Name="BtnPlay" DockPanel.Dock="Left" Content="▶ / ⏸" Click="BtnPlay_Click"/>
                <TextBlock x:Name="PosText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Text="00:00 / 00:00"/>
                <Slider x:Name="Seek" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="Seek_ValueChanged"/>
              </DockPanel>
              <TextBlock x:Name="PreviewNote" Style="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="DName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="DInfo" Style="{StaticResource Muted}"/>
              <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Inicio (s)" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtStart" Width="80" TextChanged="TxtTimes_TextChanged"/>
                <Button Content="📍 actual" Click="BtnSetStart_Click"/>
              </WrapPanel>
              <WrapPanel>
                <TextBlock Text="Fin (s)" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBox x:Name="TxtEnd" Width="80" TextChanged="TxtTimes_TextChanged"/>
                <Button Content="📍 actual" Click="BtnSetEnd_Click"/>
              </WrapPanel>
              <TextBlock x:Name="DDur" Style="{StaticResource Muted}" Margin="3,2,0,6"/>
              <WrapPanel>
                <Button Content="▶ Ver recorte" Click="BtnPlayClip_Click"/>
                <Button Content="Borrar principio" Click="BtnTrimOne_Click"/>
              </WrapPanel>
              <WrapPanel>
                <Button Content="◀ Mover" Click="BtnLeft_Click"/>
                <Button Content="Mover ▶" Click="BtnRight_Click"/>
                <Button Content="Quitar" Click="BtnRemoveClip_Click"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="#F7F7F9" CornerRadius="10" Padding="14" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="Quitar el inicio de los vídeos" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,6,0,0">
              <TextBlock Text="Quitar los primeros" VerticalAlignment="Center"/>
              <TextBox x:Name="TxtMin" Width="50" Text="0"/><TextBlock Text="min" VerticalAlignment="Center"/>
              <TextBox x:Name="TxtSec" Width="60" Text="35"/><TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="CmbScope" SelectedIndex="0" MinWidth="170">
                <ComboBoxItem Content="En los marcados"/>
                <ComboBoxItem Content="En los NO marcados"/>
                <ComboBoxItem Content="En todos los vídeos"/>
              </ComboBox>
              <Button Content="Borrar Principio" Click="BtnTrimApply_Click"/>
              <Button Content="Marcar todos" Click="BtnMarkAll_Click"/>
              <Button Content="Desmarcar todos" Click="BtnMarkNone_Click"/>
              <Button Content="Invertir marcas" Click="BtnMarkInvert_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TrimMsg" Style="{StaticResource Muted}" Margin="3,4,0,0"
                       Text="Para tiempos distintos: marca un grupo, aplica unos segundos «En los marcados» y luego otros «En los NO marcados»."/>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource H2}" Text="3. Exportar"/>
        <WrapPanel>
          <ComboBox x:Name="CmbMode" SelectedIndex="0" MinWidth="260">
            <ComboBoxItem Content="Recodificar (lento, el más fiable)"/>
            <ComboBoxItem Content="Copiar sin recodificar (muy rápido)"/>
          </ComboBox>
          <ComboBox x:Name="CmbEncoder" MinWidth="170" ToolTip="Codificador de vídeo"/>
          <TextBlock Text="Calidad (CRF)" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <TextBox x:Name="TxtCrf" Width="45" Text="22" ToolTip="Más bajo = más calidad y más tamaño. 18-23 es lo habitual."/>
          <CheckBox x:Name="ChkAutoSave" Content="Guardar sin preguntar en Vídeos\VideoCutter"/>
          <CheckBox x:Name="ChkOpenFolder" Content="Abrir la carpeta al terminar" IsChecked="True"/>
        </WrapPanel>
        <WrapPanel Margin="0,4,0,0">
          <Button x:Name="BtnExport" Content="Exportar vídeo final" FontSize="15" Padding="18,8" IsEnabled="False" Click="BtnExport_Click"/>
          <Button x:Name="BtnCancel" Content="Cancelar" Visibility="Collapsed" Click="BtnCancel_Click"/>
          <Button x:Name="BtnOpenResult" Content="Mostrar el archivo" Visibility="Collapsed" Click="BtnOpenResult_Click"/>
        </WrapPanel>

        <Border x:Name="EtaPanel" Visibility="Collapsed" Background="#F7F7F9" CornerRadius="10" Padding="14" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock x:Name="EtaPhase" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="EtaLabel" Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Tiempo restante"/>
            <TextBlock x:Name="EtaClock" FontSize="34" FontWeight="Bold" Text="--:--:--"/>
            <ProgressBar x:Name="EtaBar" Height="10" Maximum="100" Margin="0,4,0,6"/>
            <TextBlock x:Name="EtaLine" Style="{StaticResource Muted}"/>
            <TextBlock x:Name="EtaEnd" Style="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
